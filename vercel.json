{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "fluid": true,
  "env": {
    "CI_ENVIRONMENT": "production"
  },
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.6.2",
      "maxDuration": 300
    },
    "api/ws.js": {
      "maxDuration": 300
    }
  },
  "routes": [
    {
      "src": "/api/ws",
      "dest": "/api/ws.js"
    },
    {
      "src": "/(.*\\.(?:css|js|map|png|jpg|jpeg|gif|svg|webp|ico|woff|woff2|ttf|eot))$",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
