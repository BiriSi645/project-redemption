#--------------------------------------------------------------------
# Example Environment Configuration file
#
# This file can be used as a starting point for your own
# custom .env files, and contains most of the possible settings
# available in a default install.
#
# By default, all of the settings are commented out. If you want
# to override the setting, you must un-comment it by removing the '#'
# at the beginning of the line.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

# CI_ENVIRONMENT = development

# HTTPS production deployments may also set this explicitly. Cookie.php
# already enables it automatically when CI_ENVIRONMENT is production.
# cookie.secure = true

# Canonical production/custom-domain URL. Set this only in the Production
# environment on Vercel so Preview deployments can use VERCEL_URL automatically.
# APP_BASE_URL = https://example.com/
# APP_VERSION = deploy-or-commit-sha

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

# app.baseURL = ''
# app.version = '1.0.0' # Her yayınlamada değiştirildiğinde dosya taraması yapılmaz.
# If you have trouble with `.`, you could also use `_`.
# app_baseURL = ''
# app.forceGlobalSecureRequests = false
# app.CSPEnabled = false

